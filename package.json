    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/huaxel/pi-multi-opencode-go"
  },
  "bugs": {
    "url": "https://github.com/huaxel/pi-multi-opencode-go/issues"
  },
  "homepage": "https://github.com/huaxel/pi-multi-opencode-go#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "dependencies": {
    "@juanbenjumea/opencode-go-usage": "^0.3.0",
